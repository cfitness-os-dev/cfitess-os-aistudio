# Configuration serveur C.Fitness OS (Linux Debian 12 / Docker)
TZ=Europe/Paris
PORT=8080
RUST_LOG=info,cfitness_os=debug

# Serveur Rust Axum (persistance état RH V1.16 & assets dist)
CFITNESS_BIND_ADDR=0.0.0.0:8080
CFITNESS_DATA_DIR=/var/lib/cfitness
CFITNESS_FRONTEND_DIR=/app/dist

# Authentification serveur (CFOS-056 / CFOS-026) : une session Bearer est émise après vérification
# du secret local. CFITNESS_STRICT_SESSION=1 refuse toute requête sans Bearer valide.
# CFITNESS_DEMO_MODE=1 autorise uniquement le mode démo (fallback acteur via en-têtes x-cfitness-*).
# En production (CFITNESS_DEMO_MODE=0), renseigner CFITNESS_INITIAL_ADMIN_PASSWORD (>= 12 caractères)
# pour initialiser automatiquement le premier compte administrateur au premier démarrage sur base vierge.
CFITNESS_STRICT_SESSION=0
CFITNESS_DEMO_MODE=1
CFITNESS_INITIAL_ADMIN_ID=emp-mario
CFITNESS_INITIAL_ADMIN_PASSWORD=
CFITNESS_INITIAL_ADMIN_EMAIL=direction@c.fitness
CFITNESS_INITIAL_ADMIN_FIRST_NAME=Direction
CFITNESS_INITIAL_ADMIN_LAST_NAME=C.Fitness

# Intégrations provider & webhooks signés
# Stripe : secret whsec_... du dashboard Stripe. Si renseigné, la signature HMAC-SHA256
# (en-tête Stripe-Signature, tolérance 300 s) est obligatoire sur le webhook RDV.
CFITNESS_STRIPE_WEBHOOK_SECRET=
CFITNESS_STRIPE_TOLERANCE_SECONDS=300
# Webhook public Lead clubEntry : clé apiKey attendue (vide = accepte toute clé non vide)
CFITNESS_LEAD_API_KEY=
# Secrets webhooks fournisseurs entrants & synchronisation Heitz (obligatoires hors mode démo)
CFITNESS_INBOUND_WEBHOOK_SECRET=
CFITNESS_HEITZ_WEBHOOK_SECRET=
CFITNESS_WEBHOOK_TOLERANCE_SECONDS=300
# Planificateur automatique Lead (archivage & rappels RDV J-1 sur fuseau Europe/Paris)
CFITNESS_AUTOMATION_SCHEDULER=1
CFITNESS_AUTOMATION_INTERVAL_SECS=900
# Origines CORS autorisées, séparées par des virgules (vide = permissif LAN/démo)
CFITNESS_ALLOWED_ORIGINS=
# Sécurité P1 : scellement HMAC-SHA256 des sauvegardes exportées, proxy HTTPS de confiance & cookie Secure
CFITNESS_BACKUP_SIGNING_KEY=
CFITNESS_TRUST_PROXY=0
CFITNESS_COOKIE_SECURE=0

# Passerelle API Heitz-WS / Cloud HeitzSystem (Carré de Soie #3845 / Beynost #4967)
HEITZ_WS_URL=https://fitness.cf.cloud0302.heitzsystem.com
HEITZ_DEV_ID=
HEITZ_DEV_KEY=
HEITZ_CENTER_ID_CDS=3845
HEITZ_CENTER_ID_BEY=4967
# Adresses web Heitz vérifiées par l’exploitant, sans identifiant ni secret dans l’URL.
# Ces liens n’activent pas de connecteur API d’écriture.
CFITNESS_HEITZ_WEB_URL_CDS=
CFITNESS_HEITZ_WEB_URL_BEY=
HEITZ_WS_TOKEN=
TURNSTILE_MODBUS_RELAY_CDS=10.10.0.21:502
TURNSTILE_MODBUS_RELAY_BEY=10.20.0.21:502

# Téléphonie ARCEP n° 2022-1583 (Fixes 04 OVHcloud + Mobiles 07 Yeastar TG400)
SIP_TRUNK_PROVIDER=ovhcloud_sip
OVH_SIP_TRUNK_HOST=sip.ovh.fr
YEASTAR_TG400_SIP_GATEWAY=10.10.0.14:5060

# ATS recrutement, Lookin'Body 120 & Réplication multi-appareils
ATS_INBOUND_EMAIL=recrutement@c.fitness
INBODY_LB120_CSV_DROP_DIR=/var/inbody-lb120-drop
BACKUP_REPLICA_DIR=/var/backups/cfitness-os
BACKUP_SECONDARY_NODES=10.20.0.15,10.10.0.12,10.10.0.31,10.20.0.31
